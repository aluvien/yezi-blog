# 管理员后台登录密码
# 复制本文件为 .env.local 并修改为你自己的密码
ADMIN_PASSWORD=your-strong-password

# 可选：原生管理 API 的独立 Bearer Token（至少 32 个字符）。轮换后重启服务即可撤销旧令牌。
# 浏览器后台继续使用 Cookie + 同源 Origin + X-Yezi-Csrf，不应把此令牌放进前端代码。
# ADMIN_API_TOKEN=replace-with-at-least-32-random-characters

# 站点对外访问 URL（用于 SEO metadata / sitemap / RSS），末尾不要带斜杠
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# 可选：仅在确实从其他同站域名调用 Server Actions 时配置，逗号分隔；默认无需设置。
# SERVER_ACTION_ALLOWED_ORIGINS=admin.example.com

# SQLite 文件位置；生产环境建议使用绝对路径，避免启动目录变化后读到另一份数据库
# BLOG_DB_PATH=/www/wwwroot/yezi.me/data/blog.db

# 上传文件目录；生产环境建议与数据库一起放在持久化目录
# 附件固定存储在项目根目录 data/uploads，无需配置上传目录。

# 可选：App/Web API 允许的跨域来源；留空则仅允许同源访问
# API_CORS_ORIGIN=https://app.example.com

# 使用 Nginx / Cloudflare 等反向代理且由代理覆盖 X-Real-IP/X-Forwarded-For 时设为 true。
# 直连 Node 端口时保持 false，避免客户端伪造请求头绕过限频。
# 注意：GitHub 同步部署会前置检查生产环境必须为 TRUST_PROXY=true 且
# SESSION_COOKIE_SECURE=true；确为直连 HTTP 部署时显式设置 DEPLOY_DIRECT_HTTP=true 豁免。
# TRUST_PROXY=false

# 生产环境使用 HTTPS 时建议设为 true，强制会话 cookie 携带 Secure 标记。
# 反代若未正确传递 X-Forwarded-Proto，登录时可能无法自动判定 https，显式开启更稳妥。
# SESSION_COOKIE_SECURE=false

# 直连 HTTP 部署（无 HTTPS 反代）时设为 true，跳过上面的部署前置检查。
# DEPLOY_DIRECT_HTTP=false

# 本机 QQ Music API 服务地址；不设置时使用 http://127.0.0.1:3200。
# 此服务只应监听本机，不要将端口直接暴露到公网。
# QQ_MUSIC_API_URL=http://127.0.0.1:3200
# QQ_MUSIC_SESSION_PATH=/www/wwwroot/yezi.me/data/qq-music-session.json
# QQ 音乐 App 原生扫码使用的稳定设备信息；默认保存在 BLOG_DB_PATH 同目录。
# QQ_MUSIC_NATIVE_DEVICE_PATH=/www/wwwroot/yezi.me/data/qq-music-native-device.json
# 用于签发短时歌词 URL；生产建议设置至少 32 字符的随机值，否则重启后旧歌词 URL 会失效。
# QQ_MUSIC_SIGNING_KEY=replace-with-at-least-32-random-characters
# 选择一首可正常播放的 QQ 歌曲 MID，用于验证 Cookie 是否仍具备播放授权。
# QQ_MUSIC_HEALTH_CHECK_MID=004a8wRo02vuxG

# 可选：Telegram 管理员通知。两项都只保存在服务器环境变量，绝不能提交到 Git。
# TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# TELEGRAM_CHAT_ID=123456789
# 可选但推荐：管理员个人 Telegram User ID。管理命令仅接受此用户的私聊消息；
# 如果通知发到群组，此项必须配置，群组只会接收通知而不能操作评论或 QQ 登录。
# TELEGRAM_ADMIN_USER_ID=123456789

# 可选：文章编辑器“文章引用”的 AI 摘要服务（兼容 OpenAI Chat Completions 格式）
# 不配置时仍可读取标题、来源、封面并插入普通引用卡片。
# LLM_API_KEY=your-api-key
# OPENAI_API_KEY=your-api-key
# 可填写服务商根地址、/v1 地址或完整的 /chat/completions 地址
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

# 后台“同步 GitHub”使用独立 release 目录构建、健康检查、原子切换和失败回滚。
# BLOG_ENV_FILE 必须位于稳定目录、权限 0600，不能依赖 release 内未跟踪的环境文件。
# DEPLOY_PROJECT_DIR=/www/wwwroot/yezi.me
# DEPLOY_PM2_NAME=yezi-blog
# BLOG_ROOT=/www/wwwroot/yezi-state
# BLOG_DB_PATH=/www/wwwroot/yezi-state/data/blog.db
# BLOG_ENV_FILE=/www/wwwroot/yezi-state/blog.env
# DEPLOY_RELEASES_DIR=/www/wwwroot/yezi-releases
# DEPLOY_CURRENT_LINK=/www/wwwroot/yezi-current
# DEPLOY_HEALTH_URL=http://127.0.0.1:3030/api/health/deploy
# DEPLOY_KEEP_RELEASES=3
# PM2_HOME=/root/.pm2

# 完整数据备份：32 字节 base64 密钥可用 `openssl rand -base64 32` 生成。
# 配置后自动备份将加密保存 DB online snapshot、data/uploads、引用归档和本地状态。
# DATA_BACKUP_KEY=replace-with-32-byte-base64-key
# DATA_BACKUP_MIRROR_DIR=/mnt/off-host/yezi-backups
# DATA_BACKUP_KEEP=14
