# 管理员后台登录密码
# 复制本文件为 .env.local 并修改为你自己的密码
ADMIN_PASSWORD=your-strong-password

# 站点对外访问 URL（用于 SEO metadata / sitemap / RSS），末尾不要带斜杠
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# SQLite 文件位置；生产环境建议使用绝对路径，避免启动目录变化后读到另一份数据库
# BLOG_DB_PATH=/www/wwwroot/yezi.me/data/blog.db

# 上传文件目录；生产环境建议与数据库一起放在持久化目录
# UPLOAD_DIR=/www/wwwroot/yezi.me/data/uploads

# 可选：App/Web API 允许的跨域来源；留空则仅允许同源访问
# API_CORS_ORIGIN=https://app.example.com

# 使用 Nginx / Cloudflare 等反向代理且由代理覆盖 X-Real-IP/X-Forwarded-For 时设为 true。
# 直连 Node 端口时保持 false，避免客户端伪造请求头绕过限频。
# TRUST_PROXY=false

# 生产环境使用 HTTPS 时建议设为 true，强制会话 cookie 携带 Secure 标记。
# 反代若未正确传递 X-Forwarded-Proto，登录时可能无法自动判定 https，显式开启更稳妥。
# SESSION_COOKIE_SECURE=false

# 本机 QQ Music API 服务地址；不设置时使用 http://127.0.0.1:3200。
# 此服务只应监听本机，不要将端口直接暴露到公网。
# QQ_MUSIC_API_URL=http://127.0.0.1:3200
# QQ_MUSIC_SESSION_PATH=/www/wwwroot/yezi.me/data/qq-music-session.json

# 后台“同步 GitHub”按钮在服务器端直接拉取 main 并部署，不需要外部 hook
# 可选：生产项目目录和 PM2 进程名；不填进程名时会按项目目录自动识别
# DEPLOY_PROJECT_DIR=/www/wwwroot/yezi.me
# DEPLOY_PM2_NAME=yezi-blog
# PM2_HOME=/root/.pm2
