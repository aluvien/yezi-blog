# 管理员后台登录密码
# 复制本文件为 .env.local 并修改为你自己的密码
ADMIN_PASSWORD=your-strong-password

# 站点对外访问 URL（用于 SEO metadata / sitemap / RSS），末尾不要带斜杠
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# 可选：自定义 SQLite 文件位置；容器或隔离测试可使用绝对路径
# BLOG_DB_PATH=/app/data/blog.db

# 可选：上传文件目录；开发和独立部署默认统一使用 data/uploads
# UPLOAD_DIR=data/uploads

# 可选：App/Web API 允许的跨域来源；留空则仅允许同源访问
# API_CORS_ORIGIN=https://app.example.com

# 使用 Nginx / Cloudflare 等反向代理且只提供 X-Forwarded-For 时设为 true。
# Nginx 示例默认提供 X-Real-IP，不需要开启。
# TRUST_PROXY=false

# 生产环境使用 HTTPS 时建议设为 true，强制会话 cookie 携带 Secure 标记。
# 反代若未正确传递 X-Forwarded-Proto，登录时可能无法自动判定 https，显式开启更稳妥。
# SESSION_COOKIE_SECURE=false
