# Nginx 反向代理示例：将域名流量转发到本机 3030 端口的 Next.js（见 ecosystem.config.js）
# 复制到 /etc/nginx/sites-available/yezi-blog 并按需修改 server_name，
# 然后 ln -s 到 sites-enabled 并 nginx -t && systemctl reload nginx
# 注意：push 到 GitHub 不会改动服务器上的 Nginx！同步后用 `nginx -T | grep limit_req`
# 验证本文件确实已生效。若前面还有 Cloudflare，需安装 cloudflare-real-ip 模块
# （或官方 restore_client_ip 方案）把 $remote_addr 还原为真实访客 IP，
# 否则下面的按 IP 限流会按 Cloudflare 节点折叠。

# 持久限流第一层：应用内的滑动窗口限流是单进程、重启即清零的补充层，
# 这里按真实客户端 IP 限制高成本入口。速率可按流量调整，先于应用层生效。
# zone 指令属于 http 上下文；本文件被 http{} include，因此放在 server 之外。
limit_req_zone $binary_remote_addr zone=yezi_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=yezi_login:10m rate=1r/s;

server {
    listen 80;
    server_name example.com;  # TODO: 改成你的域名

    # 后台上传图片的大小上限（按需调整）
    client_max_body_size 22m;

    # 部署健康检查只给本机 deploy worker 用；公网一律 403。
    # （应用层还有第二道保险：写探针只认部署时注入的一次性 token。）
    location = /api/health/deploy {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # 登录入口单独收紧：防爆破（应用层还有按 IP + 按账户两层计数）。
    location = /admin/login {
        limit_req zone=yezi_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location = /api/admin/login {
        limit_req zone=yezi_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # JSON API（公开列表、首页流、互动等）统一限速；uploads 静态资源不限。
    location /api/ {
        limit_req zone=yezi_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 必须转发真实域名：若被 Next 当作 host 且与浏览器 Origin 不一致，
        # 后台 Server Actions（保存/删除等）会被同源校验拦截报错。
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}

# 启用 HTTPS（推荐 certbot）后示例：
# server {
#     listen 443 ssl;
#     server_name example.com;
#     ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
#     # 仅在确认所有子域名都已永久启用 HTTPS 后取消下一行注释；启用后浏览器会
#     # 强制后续请求走 HTTPS，错误配置可能导致旧 HTTP 子域无法访问。
#     # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
#     client_max_body_size 22m;
#     # 上方 server 中的限流 location 与代理头配置在此块中原样复制一份。
#     location / { ... 同上 ... }
# }
